<?xml version="1.0" encoding="UTF-8" ?>
<Mascot xmlns="http://www.group-finity.com/Mascot" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.group-finity.com/Mascot Mascot.xsd">

	<!--
		GLaDOS AI 行为映射表（默认）
		================================
		设计文档：docs/glados-ai-integration-design.md §5

		规则：
		1. 所有 AI 行为复用 conf/actions.xml 中已有动作，不新增动作；
		2. Frequency="0"：不会被自主行为树（behaviors.xml 加权随机）选中，
		   只能被 GladosBridge 的 setBehavior 显式构建；
		3. AIIdle 无动作（Action 缺省 = 行为名），只作为回退标记，
		   由 GladosBridge 在收到 idle 时调用 setBehaviorAll 切回自主树
		   （buildNextBehavior(null)）；
		4. 触发型行为（AIReview）播完（Loop=false）后由 UserBehavior.init
		   自动走 buildNextBehavior 回到自主行为（Frequency=0 不参与随机，
		   因此会回到 Fall 兜底，再自然进入自主树）。

		覆盖：GLaDOS 可在 glados-home 目录放置 glados-behaviors.xml 覆盖本文件。
	-->

	<BehaviorList>

		<!-- idle：回到自主模式（桥层特殊处理，不直接构建；Action=Sit 仅为通过 validate） -->
		<Behavior Name="AIIdle" Frequency="0" Hidden="true" Action="Sit" />

		<!-- running：AI 处理中，兴奋/忙碌 -->
		<Behavior Name="AIWorking" Frequency="0" Hidden="true" Action="Walk">
			<NextBehaviorList Add="false">
				<BehaviorReference Name="AIWorking" Frequency="1" Action="Walk" />
			</NextBehaviorList>
		</Behavior>

		<!-- waiting：等待审批/回答，期待地看着你 -->
		<Behavior Name="AIWaiting" Frequency="0" Hidden="true" Action="SitAndLookUp">
			<NextBehaviorList Add="false">
				<BehaviorReference Name="AIWaiting" Frequency="1" Action="SitAndLookUp" />
			</NextBehaviorList>
		</Behavior>

		<!-- review：完成，庆祝（触发型，播完回到自主） -->
		<Behavior Name="AIReview" Frequency="0" Hidden="true" Action="SitAndSpinHead">
			<NextBehaviorList Add="false">
				<BehaviorReference Name="AIReview" Frequency="1" Action="SitAndSpinHead" />
			</NextBehaviorList>
		</Behavior>

		<!-- failed：失败，沮丧趴下 -->
		<Behavior Name="AIFailed" Frequency="0" Hidden="true" Action="LieDown">
			<NextBehaviorList Add="false">
				<BehaviorReference Name="AIFailed" Frequency="1" Action="LieDown" />
			</NextBehaviorList>
		</Behavior>

		<!-- disconnected：断连，静止 -->
		<Behavior Name="AIDisconnected" Frequency="0" Hidden="true" Action="Sit">
			<NextBehaviorList Add="false">
				<BehaviorReference Name="AIDisconnected" Frequency="1" Action="Sit" />
			</NextBehaviorList>
		</Behavior>

		<!--
			GLaDOS 托管：禁用自主增殖行为。
			与 Main.run() 里按托管状态设置 Breeding=false 构成双保险：
			- 本文件 Frequency=0  → 不被自主行为树选中（连分裂动作都不播）
			- Breeding=false      → 即使被显式构建也不会产生新角色
			注意：GLaDOS 主动下发的 createMascot 命令不受影响。
			本文件仅在托管模式下加载，用户直接运行不会读到这些覆盖。
			设计文档：docs/glados-managed-constraints-design.md §4.2
		-->
		<Behavior Name="SplitIntoTwo" Frequency="0" Hidden="true" Action="Sit" />
		<Behavior Name="PullUpShimeji" Frequency="0" Hidden="true" Action="Sit" />

	</BehaviorList>
</Mascot>